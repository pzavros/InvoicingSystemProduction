# ═══════════════════════════════════════════════════════════════════════════
# ENVIRONMENT VARIABLES TEMPLATE
# ═══════════════════════════════════════════════════════════════════════════
# Copy this file to .env.development for local development
# Copy this file to .env.production for production deployment
# Replace all placeholder values with actual values
# NEVER commit .env.development or .env.production to Git!
# ═══════════════════════════════════════════════════════════════════════════

# ============================
# Backend Configuration
# ============================

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-at-least-32-characters-long
JWT_ISSUER=InvoicingSystemAPI
JWT_AUDIENCE=InvoicingSystemUsers
JWT_EXPIRATION_MINUTES=60

# Database Configuration
# Development: Use localhost
# Production: Use postgres (Docker service name)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=InvoicingSystemDevelopment
DB_USERNAME=postgres
DB_PASSWORD=postgres
POSTGRES_PASSWORD=postgres
ConnectionStrings__DefaultConnection=Host=localhost;Port=5432;Database=InvoicingSystemDevelopment;Username=postgres;Password=postgres

# Email Configuration (Microsoft Graph API)
EMAIL_USE_GRAPH=true
EMAIL_TENANT_ID=your-microsoft-tenant-id
EMAIL_CLIENT_ID=your-microsoft-client-id
EMAIL_CLIENT_SECRET=your-microsoft-client-secret
EMAIL_FROM_ADDRESS=support@yourdomain.com
EMAIL_FROM_NAME=Your App Name

# Email Configuration (SMTP Fallback)
EMAIL_SMTP_HOST=smtp.office365.com
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USERNAME=noreply@yourdomain.com
EMAIL_SMTP_PASSWORD=your-smtp-password
EMAIL_USE_SSL=true
EMAIL_ENABLE_SSL=true

# Application Settings
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://0.0.0.0:5088

# Stripe Configuration
# Development: Use test keys (sk_test_... and pk_test_...)
# Production: Use live keys (sk_live_... and pk_live_...)
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret
STRIPE_PRICE_ID=price_your_stripe_price_id
STRIPE_PAYMENT_LINK=https://buy.stripe.com/your_payment_link

# Subscription Pricing
SUBSCRIPTION_MONTHLY_PRICE=13.99

# ============================
# Frontend Configuration (Vite)
# ============================

# API Configuration
# Development: Empty string uses Vite proxy
# Production: /api (goes through Caddy reverse proxy)
VITE_APP_API_BASE_URL=

# API Endpoints
VITE_ADMIN_API_ENDPOINT=/api/admin
VITE_REGULAR_API_ENDPOINT=/api

# App Information
VITE_APP_NAME=E-nvoicing System
VITE_APP_VERSION=1.0.0

# Subscription Pricing (Frontend needs this)
VITE_SUBSCRIPTION_MONTHLY_PRICE=13.99

# Stripe Configuration (Frontend needs publishable key only)
# Development: Use test publishable key
# Production: Use live publishable key
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key

# ============================
# Webpage/Admin Configuration (Vite)
# ============================

# API Configuration
VITE_API_BASE_URL=

# Admin Configuration
VITE_ADMIN_API_ENDPOINT=/api/admin
VITE_REGULAR_API_ENDPOINT=/api

# ═══════════════════════════════════════════════════════════════════════════
# QUICK START
# ═══════════════════════════════════════════════════════════════════════════
# 1. Copy this file:
#    cp .env.example .env.development
#
# 2. Update the values in .env.development with your actual credentials
#
# 3. For Stripe test mode, get your keys from:
#    https://dashboard.stripe.com/test/apikeys
#
# 4. For email configuration, set up Microsoft Graph API or use SMTP
#
# 5. Run the application:
#    cd Backend && dotnet run
#    cd Frontend && npm run dev
#
# ═══════════════════════════════════════════════════════════════════════════
