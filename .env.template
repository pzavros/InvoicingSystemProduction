# Email Configuration Template
# Copy this file to .env.development or .env.production and fill in your values

# SMTP Configuration for Office 365/Outlook
EMAIL_SMTP_HOST=smtp.office365.com
EMAIL_SMTP_PORT=587

# Your email credentials
EMAIL_SMTP_USERNAME=your-email@yourdomain.com
EMAIL_SMTP_PASSWORD=your-app-password

# Email sender information
EMAIL_FROM_NAME=Your Company Name
EMAIL_FROM_ADDRESS=your-email@yourdomain.com

# Security settings (keep as true for Office 365)
EMAIL_USE_SSL=true
EMAIL_ENABLE_SSL=true

# Other environment variables you might need:
# DATABASE_CONNECTION_STRING=your-database-connection-string
# JWT_SECRET=your-jwt-secret-key
