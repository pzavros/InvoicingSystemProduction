# ==============================================
# Production Environment Variables
# ==============================================
# This file should be created manually on your production server
# and should NEVER be committed to git
#
# Location: /opt/InvoicingSystemProduction/.env.production

# ============== DATABASE ==============
POSTGRES_PASSWORD=YourSecurePasswordHere123!

# ============== EMAIL CONFIGURATION ==============
# Choose between Microsoft Graph API or SMTP

# Use Graph API (true) or SMTP (false)
EMAIL_USE_GRAPH=true

# --- Microsoft Graph API Settings (recommended for Office 365) ---
EMAIL_TENANT_ID=your-tenant-id
EMAIL_CLIENT_ID=your-client-id  
EMAIL_CLIENT_SECRET=your-client-secret-value

# --- Email Identity ---
EMAIL_FROM_ADDRESS=your-email@yourdomain.com
EMAIL_FROM_NAME=Your Company Name

# --- SMTP Settings (fallback if not using Graph) ---
EMAIL_SMTP_HOST=smtp.office365.com
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USERNAME=your-email@yourdomain.com
EMAIL_SMTP_PASSWORD=your-email-password
EMAIL_USE_SSL=true
EMAIL_ENABLE_SSL=true

# ============== OTHER SETTINGS ==============
# Add any other production secrets here
